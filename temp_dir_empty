#!/usr/bin/env python
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from workspace_detector import detect_project_type, is_git_repo, get_package_manager

# Test empty directory
print("=== Empty Directory ===")
print(f"detect_project_type: {detect_project_type('temp_dir_empty')}")
print(f"is_git_repo: {is_git_repo('temp_dir_empty')}")
print(f"get_package_manager: {get_package_manager('temp_dir_empty')}")

# Test directory with index.html
os.makedirs(os.path.join('temp_dir_empty', 'index.html'), exist_ok=True)
with open(os.path.join('temp_dir_empty', 'index.html'), 'w') as f:
    f.write('<html></html>')

print("\n=== Directory with index.html ===")
print(f"detect_project_type: {detect_project_type('temp_dir_empty')}")
print(f"is_git_repo: {is_git_repo('temp_dir_empty')}")
print(f"get_package_manager: {get_package_manager('temp_dir_empty')}")

# Test directory with package.json
os.makedirs(os.path.join('temp_dir_empty', 'package.json'), exist_ok=True)
with open(os.path.join('temp_dir_empty', 'package.json'), 'w') as f:
    f.write('{}')

print("\n=== Directory with package.json ===")
print(f"detect_project_type: {detect_project_type('temp_dir_empty')}")
print(f"is_git_repo: {is_git_repo('temp_dir_empty')}")
print(f"get_package_manager: {get_package_manager('temp_dir_empty')}")

# Test directory with requirements.txt
os.makedirs(os.path.join('temp_dir_empty', 'requirements.txt'), exist_ok=True)
with open(os.path.join('temp_dir_empty', 'requirements.txt'), 'w') as f:
    f.write('pytest')

print("\n=== Directory with requirements.txt ===")
print(f"detect_project_type: {detect_project_type('temp_dir_empty')}")
print(f"is_git_repo: {is_git_repo('temp_dir_empty')}")
print(f"get_package_manager: {get_package_manager('temp_dir_empty')}")

# Test directory with both package.json and requirements.txt
os.makedirs(os.path.join('temp_dir_empty', 'package.json'), exist_ok=True)
with open(os.path.join('temp_dir_empty', 'package.json'), 'w') as f:
    f.write('{}')

os.makedirs(os.path.join('temp_dir_empty', 'requirements.txt'), exist_ok=True)
with open(os.path.join('temp_dir_empty', 'requirements.txt'), 'w') as f:
    f.write('pytest')

print("\n=== Directory with package.json + requirements.txt ===")
print(f"detect_project_type: {detect_project_type('temp_dir_empty')}")
print(f"is_git_repo: {is_git_repo('temp_dir_empty')}")
print(f"get_package_manager: {get_package_manager('temp_dir_empty')}")

# Test directory with .git initialized
os.system('git init temp_dir_empty')
os.system('git config --local user.email "test@example.com"')
os.system('git config --local user.name "Test User"')

print("\n=== Directory with .git initialized ===")
print(f"detect_project_type: {detect_project_type('temp_dir_empty')}")
print(f"is_git_repo: {is_git_repo('temp_dir_empty')}")
print(f"get_package_manager: {get_package_manager('temp_dir_empty')}")

# Test nonexistent directory
try:
    print("\n=== Nonexistent Directory ===")
    print(f"detect_project_type: {detect_project_type('nonexistent_dir')}")
except Exception as e:
    print(f"Exception for nonexistent directory: {type(e).__name__}: {e}")