# ANOMYMOUS Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================
# Testing Mode (Disable this for production with real APIs)
# ============================================================
# Set to "1" to use mock transport for testing without API keys
ANOMYMOUS_USE_MOCK=0

# ============================================================
# Local LLM Router Integration
# ============================================================
# Endpoint for a local LLM router (e.g., free-llm-api-server)
# Leave empty to use configured provider APIs instead
# LLM_API_ENDPOINT=http://127.0.0.1:31415/v1
# LLM_API_KEY=sk-local-key-12345

# ============================================================
# Provider API Keys
# ============================================================
# Groq API key (free tier available at https://console.groq.com/)
GROQ_API_KEY=

# Cerebras API key (https://www.cerebras.ai/)
CEREBRAS_API_KEY=

# ============================================================
# Cloud Deployment (Vercel/Cloud only)
# ============================================================
# Set to "1" when deploying to Vercel/cloud environments
# VERCEL=0
# CLOUD_DEPLOYMENT=0
